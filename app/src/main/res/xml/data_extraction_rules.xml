<?xml version="1.0" encoding="utf-8"?><!--
   Backup rules for Android 12+.
   See https://developer.android.com/about/versions/12/backup-restore#xml-changes
   The coprocessor API token must never leave the device.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="coprocessor_settings.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="coprocessor_settings.xml" />
    </device-transfer>
</data-extraction-rules>
